<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.sheeets.linkedtext" ExtensionBundleVersion="0.3.0" ExtensionBundleName="Sheeets" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.sheeets.linkedtext.panel" Version="0.3.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[23.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.sheeets.linkedtext.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- only used as a fallback to read the clipboard ("Pegar") when the browser clipboard API is denied -->
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Sheeets</Menu>
          <Geometry>
            <Size><Height>520</Height><Width>320</Width></Size>
            <MinSize><Height>200</Height><Width>220</Width></MinSize>
          </Geometry>
          <!-- icon of the collapsed panel; Dark* are used on Illustrator's dark themes (generated from img/sheeets.svg) -->
          <Icons>
            <Icon Type="Normal">./img/panel.png</Icon>
            <Icon Type="RollOver">./img/panel-hover.png</Icon>
            <Icon Type="DarkNormal">./img/panel-dark.png</Icon>
            <Icon Type="DarkRollOver">./img/panel-dark-hover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
